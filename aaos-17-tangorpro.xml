<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Remote definition for our custom GitHub organization -->
  <remote name="tangorpro-git"
          fetch="https://github.com/a17-tangorpro-aaos"
          revision="android-17.0.0_r1-tangorpro" />

  <!-- ============================================================ -->
  <!-- 1. REMOVE-PROJECT DECLARATIONS (MUST BE AT THE TOP)          -->
  <!-- ============================================================ -->
  <remove-project name="platform/packages/apps/Car/Settings" />
  <remove-project name="device/google_car" />
  <remove-project name="platform/hardware/interfaces" />
  <remove-project name="platform/build/release" />
  <remove-project name="platform/build/soong" />
  <remove-project name="platform/external/skia" />
  <remove-project name="platform/system/core" />
  <remove-project name="platform/system/extras" />
  <remove-project name="platform/system/unwinding" />

  <!-- ============================================================ -->
  <!-- 2. CUSTOM PROJECT FORKS (SWAPPED IN)                         -->
  <!-- ============================================================ -->
  <project path="packages/apps/Car/Settings" name="packages_apps_Car_Settings" remote="tangorpro-git" />
  <project path="device/google_car" name="device_google_car" remote="tangorpro-git" />
  <project path="hardware/interfaces" name="hardware_interfaces" remote="tangorpro-git" />
  <project path="build/release" name="build_release" remote="tangorpro-git" />
  <project path="build/soong" name="build_soong" remote="tangorpro-git" />
  <project path="external/skia" name="external_skia" remote="tangorpro-git" />
  <project path="system/core" name="system_core" remote="tangorpro-git" />
  <project path="system/extras" name="system_extras" remote="tangorpro-git" />
  <project path="system/unwinding" name="system_unwinding" remote="tangorpro-git" />

  <!-- ============================================================ -->
  <!-- 3. CUSTOM DEVICE ADDITIONS (NOT IN DEFAULT AOSP)             -->
  <!-- ============================================================ -->
  <project path="device/google/tangorpro" name="device_google_tangorpro" remote="tangorpro-git" />
  <project path="device/google/tangorpro-kernels/6.1" name="device/google/tangorpro-kernels/6.1" revision="main" clone-depth="1" />
  <project path="device/google/gs201" name="device_google_gs201" remote="tangorpro-git" />
  <project path="device/google/gs-common" name="device_google_gs-common" remote="tangorpro-git" />
  <project path="device/google/gs201-sepolicy" name="device_google_gs201-sepolicy" remote="tangorpro-git" />
  <project path="device/google/gs101" name="device_google_gs101" remote="tangorpro-git" />
  <project path="device/google/gs101-sepolicy" name="device/google/gs101-sepolicy" revision="refs/tags/android-15.0.0_r1" />
  <project path="device/google/tangorpro-sepolicy" name="device/google/tangorpro-sepolicy" revision="refs/tags/android-15.0.0_r1" />
  <project path="hardware/google/pixel" name="hardware_google_pixel" remote="tangorpro-git" />
  <project path="hardware/google/pixel-sepolicy" name="platform/hardware/google/pixel-sepolicy" revision="refs/tags/android-15.0.0_r1" />
  <project path="hardware/google/gchips" name="platform/hardware/google/gchips" revision="refs/tags/android-15.0.0_r1" />
  <project path="hardware/google/graphics/common" name="hardware_google_graphics_common" remote="tangorpro-git" />
  <project path="hardware/google/graphics/gs101" name="platform/hardware/google/graphics/gs101" revision="refs/tags/android-15.0.0_r1" />
  <project path="hardware/google/graphics/gs201" name="hardware_google_graphics_gs201" remote="tangorpro-git" />

</manifest>
